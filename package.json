{
  "name": "earth-survival-diary",
  "private": true,
  "version": "2026.10.6-4",
  "author": "XueWerY <3073820063@qq.com>",
  "type": "module",
  "main": "electron/main.cjs",
  "repository": "XueWerY/earth-survival-diary",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "server:start": "node server/index.cjs",
    "server:package": "node scripts/package-server.cjs",
    "data:migrate:mysql-to-yaml": "node scripts/migrate-mysql-to-yaml.cjs",
    "build": "node scripts/build-tools.cjs install-deps && vite build && node electron/build-plugin.cjs && node scripts/package-default-plugins.cjs && node scripts/generate-icons.js && node scripts/build-tools.cjs make-ico",
    "electron:build:win": "node scripts/build-tools.cjs pre-clean-release && npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --win && node scripts/build-tools.cjs cleanup-release",
    "electron:build:win:release": "node scripts/build-tools.cjs pre-clean-release && npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --win && node scripts/build-tools.cjs cleanup-release",
    "publish-release": "node scripts/build-tools.cjs publish-release"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@lucide/vue": "^1.46.0",
    "@milkdown/crepe": "7.22.1",
    "@milkdown/kit": "7.22.1",
    "dayjs": "^1.11.20",
    "echarts": "^6.0.0",
    "element-plus": "^2.13.6",
    "gsap": "^3.15.0",
    "highlight.js": "^11.11.1",
    "html2canvas": "1.4.1",
    "jsqr": "^1.4.0",
    "lunar-javascript": "^1.7.7",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "vue": "^3.5.24",
    "vue-router": "4"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.9.1",
    "cross-env": "^7.0.3",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.1",
    "mysql2": "^3.11.5",
    "pino-pretty": "^13.1.3",
    "puppeteer-core": "^23.11.1",
    "sharp": "^0.34.5",
    "typescript": "^5.8.5",
    "vite": "^8.0.8",
    "vue-tsc": "^3.1.0",
    "yaml": "^2.9.1"
  },
  "build": {
    "appId": "com.earth-survival-diary.app",
    "productName": "地球 Online 生存日记",
    "artifactName": "Earth-Survival-Diary-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/mysql.config.json",
      "build/**/*",
      "!build/default-plugins/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "build/icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "build/icon.ico"
      },
      {
        "from": "build/default-plugins",
        "to": "default-plugins"
      },
      {
        "from": "electron/node_modules",
        "to": "node_modules"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "publish": {
      "provider": "generic",
      "url": "https://www.earth-survival-diary.icu/updates/",
      "channel": "latest"
    }
  }
}
